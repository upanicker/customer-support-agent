# Optional: the app automatically uses local demo knowledge if these are absent.
OPENAI_API_KEY=
# Model used to compose the final answer after retrieval and specialist reviews.
OPENAI_RESPONSE_MODEL=gpt-5.2
# Optional: use a lower-cost model for built-in Billing, Order, and Technical reviews.
OPENAI_SPECIALIST_MODEL=

# Optional LangSmith observability. With a key, LangGraph automatically records
# the graph, each node, retrieval, A2A handoffs, and wrapped OpenAI calls.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resolveai-customer-support

PINECONE_API_KEY=
PINECONE_INDEX=customer-support-kb
PINECONE_NAMESPACE=help-center

# Optional A2A-compatible specialist endpoints. When several domains match a
# request, all matching specialists are consulted before the final response.
A2A_BILLING_URL=
A2A_ORDERS_URL=
A2A_TECHNICAL_URL=
